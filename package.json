{
  "name": "@cluesurf/mark",
  "version": "0.6.0",
  "description": "Ancient Script Fonts by ClueSurf",
  "license": "OFL-1.1",
  "repository": "github:cluesurf/mark",
  "keywords": [
    "font",
    "typeface",
    "ancient scripts",
    "unicode"
  ],
  "archive": {
    "identifier": "mark-font",
    "title": "Mark"
  },
  "type": "module",
  "scripts": {
    "make": "rm -rf host && tsc && tsc-alias",
    "assign": "tsx code/assign-code-points.ts",
    "make:fonts": "tsx code/make-fonts.ts",
    "make:grids": "tsx code/make-grids.ts",
    "make:readmes": "tsx code/make-readmes.ts",
    "check:fonts": "tsx code/check-fonts.ts",
    "scan": "rm -rf host && concurrently --kill-others \"tsc -w\" \"tsc-alias -w\"",
    "host": "pnpm make && npm publish --access=public"
  },
  "prettier": "@cluesurf/wash/flow.json",
  "devDependencies": {
    "@cluesurf/wash": "0.7.0",
    "@types/node": "25.2.3",
    "concurrently": "9.2.1",
    "eslint": "10.0.0",
    "opentype.js": "1.3.4",
    "svg-pathdata": "^8.0.0",
    "tsc-alias": "1.8.16",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
