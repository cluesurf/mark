{
  "name": "@cluesurf/mark",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "make": "rm -rf host && tsc && tsc-alias",
    "make:font": "tsx code/make-font.ts",
    "scan": "rm -rf host && concurrently --kill-others \"tsc -w\" \"tsc-alias -w\"",
    "host": "pnpm make && npm publish --access=public"
  },
  "prettier": "@cluesurf/wash/flow.json",
  "devDependencies": {
    "@cluesurf/wash": "0.7.0",
    "@types/node": "25.2.3",
    "concurrently": "9.2.1",
    "eslint": "10.0.0",
    "opentype.js": "1.3.4",
    "svg-pathdata": "^8.0.0",
    "tsc-alias": "1.8.16",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
